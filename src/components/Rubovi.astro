---
// Pozadina u boji stranice preko cijelog ekrana, iza sadržaja. Safari na iPhoneu (iOS 26) ne gleda
// theme-color, nego boju neprozirnog fiksnog elementa uz gornji i donji rub ekrana (traka od nekoliko
// piksela, širine barem 90 % ekrana; tanji ili uži elementi se preskaču). Zato drugi fiksni slojevi
// preko cijelog ekrana (snijeg) počinju 12 px od ruba.
interface Props {
  boja: string;
}
const { boja } = Astro.props;
---

<div class="rubovi" style={`background-color:${boja}`} aria-hidden="true"></div>

<style>
  .rubovi {
    position: fixed;
    inset: 0;
    z-index: -1;
  }
</style>
