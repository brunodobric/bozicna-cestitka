---
// Noćna zimska scena na dnu početne stranice: brežuljci pod snijegom, kuće, drvca s lampicama,
// ulične svjetiljke, snjegović i saonice s darovima. Čisti SVG, bez slika.
// Na mobitelu se vidi srednji dio (preserveAspectRatio slice), zato su glavni likovi u sredini.
const LAMPICE = ['#f5cf58', '#e0483f', '#faf6f0', '#f5cf58', '#e0483f', '#faf6f0'];

type Drvce = { x: number; y: number; s: number; lampice?: boolean };
const DRVCA_IZA: Drvce[] = [
  { x: 60, y: 408, s: 0.8 },
  { x: 215, y: 400, s: 1.05 },
  { x: 330, y: 404, s: 0.7 },
  { x: 1010, y: 402, s: 0.75 },
  { x: 1215, y: 398, s: 1.1 },
  { x: 1385, y: 408, s: 0.85 },
];
const DRVCA_ISPRED: Drvce[] = [
  { x: 150, y: 462, s: 1.25, lampice: true },
  { x: 560, y: 452, s: 1.55, lampice: true },
  { x: 1130, y: 458, s: 1.3, lampice: true },
  { x: 1320, y: 470, s: 1.0 },
];
// položaj lampica na drvcu (u koordinatama drvca, podnožje je u 0,0)
const TOCKE = [
  [-6, -150],
  [8, -128],
  [-14, -112],
  [16, -96],
  [-2, -88],
  [-26, -70],
  [24, -62],
  [4, -52],
  [-36, -34],
  [-10, -30],
  [18, -26],
  [40, -30],
];
---

<svg class="scena" viewBox="0 0 1440 520" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sc-brijeg-iza" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b9c9c4"></stop>
      <stop offset="1" stop-color="#8fa5a0"></stop>
    </linearGradient>
    <linearGradient id="sc-brijeg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.55" stop-color="#faf6f0"></stop>
      <stop offset="1" stop-color="#faf6f0"></stop>
    </linearGradient>
    <radialGradient id="sc-sjaj" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffe7a3" stop-opacity="0.75"></stop>
      <stop offset="0.35" stop-color="#f5cf58" stop-opacity="0.28"></stop>
      <stop offset="1" stop-color="#d4af37" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="sc-tlo-sjaj" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffe7a3" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#ffe7a3" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="sc-snjeg" cx="0.36" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.6" stop-color="#f1ede6"></stop>
      <stop offset="1" stop-color="#b8c6c4"></stop>
    </radialGradient>
    <linearGradient id="sc-saonice" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c22a2a"></stop>
      <stop offset="1" stop-color="#8b0000"></stop>
    </linearGradient>
    <linearGradient id="sc-zlato" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f3d77a"></stop>
      <stop offset="0.5" stop-color="#d4af37"></stop>
      <stop offset="1" stop-color="#9c7a1c"></stop>
    </linearGradient>
    <linearGradient id="sc-drvo-l" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#2a6a4d"></stop>
      <stop offset="0.5" stop-color="#1b4332"></stop>
      <stop offset="1" stop-color="#0f2a1f"></stop>
    </linearGradient>

    <!-- drvce: podnožje debla je u (0,0) -->
    <g id="sc-drvce">
      <rect x="-5" y="-16" width="10" height="18" fill="#3a2718"></rect>
      <path d="M0 -98 L46 -14 Q0 2 -46 -14 Z" fill="url(#sc-drvo-l)"></path>
      <path d="M-46 -14 Q0 2 46 -14 L41 -23 Q22 -12 8 -18 Q-6 -10 -20 -18 Q-32 -13 -41 -23 Z" fill="#faf6f0"></path>
      <path d="M0 -132 L36 -58 Q0 -44 -36 -58 Z" fill="url(#sc-drvo-l)"></path>
      <path d="M-36 -58 Q0 -44 36 -58 L31 -67 Q16 -56 4 -62 Q-8 -54 -18 -62 Q-26 -58 -31 -67 Z" fill="#faf6f0"></path>
      <path d="M0 -164 L26 -100 Q0 -88 -26 -100 Z" fill="url(#sc-drvo-l)"></path>
      <path d="M-26 -100 Q0 -88 26 -100 L22 -108 Q10 -99 2 -104 Q-8 -97 -14 -104 Q-19 -101 -22 -108 Z" fill="#faf6f0"></path>
      <path d="M0 -164 L9 -142 Q4 -146 0 -141 Q-4 -147 -9 -142 Z" fill="#faf6f0"></path>
    </g>
    <path id="sc-zvijezda" d="M0 -12 L3.2 -3.8 L12 -3.6 L5 1.8 L7.4 10.4 L0 5.4 L-7.4 10.4 L-5 1.8 L-12 -3.6 L-3.2 -3.8 Z" fill="url(#sc-zlato)"></path>

    <!-- ulična svjetiljka: podnožje stupa je u (0,0) -->
    <g id="sc-svjetiljka">
      <circle cx="0" cy="-196" r="120" fill="url(#sc-sjaj)"></circle>
      <ellipse cx="0" cy="4" rx="70" ry="10" fill="#f5cf58" opacity="0.22"></ellipse>
      <rect x="-3" y="-176" width="6" height="178" fill="#0b1512"></rect>
      <rect x="-8" y="-14" width="16" height="16" rx="2" fill="#0b1512"></rect>
      <rect x="-6" y="-60" width="12" height="5" rx="2" fill="#0b1512"></rect>
      <path d="M-22 -150 Q-22 -168 -3 -168 M22 -150 Q22 -168 3 -168" stroke="#0b1512" stroke-width="3" fill="none"></path>
      <path d="M-12 -210 L12 -210 L8 -178 L-8 -178 Z" fill="#ffe9ad"></path>
      <path d="M-12 -210 L12 -210 L8 -178 L-8 -178 Z M0 -210 L0 -178" stroke="#0b1512" stroke-width="2.5" fill="none"></path>
      <path d="M-17 -210 L0 -226 L17 -210 Z" fill="#0b1512"></path>
      <path d="M-17 -211 Q-10 -222 0 -228 Q10 -222 17 -211 Q8 -215 0 -214 Q-8 -215 -17 -211 Z" fill="#faf6f0"></path>
      <circle cx="0" cy="-230" r="3" fill="#0b1512"></circle>
      <rect x="-10" y="-180" width="20" height="4" rx="1" fill="#0b1512"></rect>
    </g>

    <!-- kuća u daljini: sredina podnožja je u (0,0) -->
    <g id="sc-kuca">
      <circle cx="0" cy="-34" r="80" fill="url(#sc-tlo-sjaj)" opacity="0.5"></circle>
      <rect x="26" y="-104" width="14" height="30" fill="#0c1d17"></rect>
      <path d="M24 -104 h18 v-5 q-9 -5 -18 0 Z" fill="#e9eeea"></path>
      <rect x="-56" y="-62" width="112" height="64" fill="#10261d"></rect>
      <path d="M-68 -60 L0 -112 L68 -60 Z" fill="#0c1d17"></path>
      <path d="M-70 -58 L0 -116 L70 -58 L62 -58 L0 -104 L-62 -58 Z" fill="#e9eeea"></path>
      <g fill="#f5cf58">
        <rect x="-40" y="-44" width="20" height="22" rx="1"></rect>
        <rect x="20" y="-44" width="20" height="22" rx="1"></rect>
        <rect x="-7" y="-82" width="14" height="14" rx="7"></rect>
      </g>
      <path d="M-30 -44 v22 M-40 -33 h20 M30 -44 v22 M20 -33 h20" stroke="#10261d" stroke-width="2"></path>
      <rect x="-9" y="-30" width="18" height="32" rx="1" fill="#6e1414"></rect>
      <circle cx="0" cy="-20" r="5" fill="none" stroke="#2a6a4d" stroke-width="3"></circle>
    </g>
  </defs>

  <!-- brežuljci u daljini -->
  <path d="M0 404 Q180 350 380 392 T760 372 T1140 388 T1440 360 V520 H0 Z" fill="url(#sc-brijeg-iza)"></path>

  <!-- kuće -->
  <use href="#sc-kuca" transform="translate(120 396) scale(0.95)"></use>
  <use href="#sc-kuca" transform="translate(648 380) scale(0.8)"></use>
  <use href="#sc-kuca" transform="translate(1300 384) scale(1)"></use>

  {DRVCA_IZA.map((d) => <use href="#sc-drvce" transform={`translate(${d.x} ${d.y}) scale(${d.s})`} opacity="0.82" />)}

  <!-- prednji snijeg -->
  <path d="M0 452 Q160 418 360 440 T720 432 T1080 444 T1440 426 V520 H0 Z" fill="url(#sc-brijeg)"></path>
  <path d="M0 452 Q160 418 360 440 T720 432 T1080 444 T1440 426" stroke="#ffffff" stroke-width="3" fill="none" opacity="0.9"></path>

  <!-- svjetiljke -->
  <use href="#sc-svjetiljka" transform="translate(410 446) scale(1.02)"></use>
  <use href="#sc-svjetiljka" transform="translate(1040 452) scale(1.02)"></use>
  <use href="#sc-svjetiljka" transform="translate(30 462) scale(0.9)" class="scena__siroko"></use>
  <use href="#sc-svjetiljka" transform="translate(1415 448) scale(0.9)" class="scena__siroko"></use>

  <!-- drvca s lampicama -->
  {
    DRVCA_ISPRED.map((d, n) => (
      <g transform={`translate(${d.x} ${d.y}) scale(${d.s})`}>
        <ellipse cx="6" cy="2" rx="50" ry="7" fill="#9fb1ad" opacity="0.45" />
        <use href="#sc-drvce" />
        {d.lampice && (
          <>
            <use href="#sc-zvijezda" transform="translate(0 -168)" />
            {TOCKE.map(([x, y], i) => (
              <circle class="scena__lampica" style={`animation-delay:${((i * 0.37 + n * 0.5) % 2.4).toFixed(2)}s`} cx={x} cy={y} r="2.6" fill={LAMPICE[(i + n) % LAMPICE.length]} />
            ))}
          </>
        )}
      </g>
    ))
  }

  <!-- snjegović -->
  <g transform="translate(725 462)">
    <ellipse cx="8" cy="0" rx="52" ry="8" fill="#9fb1ad" opacity="0.5"></ellipse>
    <path d="M-22 -86 L-58 -112 M-48 -105 L-56 -96 M-46 -104 L-50 -116" stroke="#3a2718" stroke-width="3" stroke-linecap="round" fill="none"></path>
    <path d="M22 -86 L58 -108 M48 -102 L58 -96 M46 -101 L48 -114" stroke="#3a2718" stroke-width="3" stroke-linecap="round" fill="none"></path>
    <circle cx="0" cy="-36" r="38" fill="url(#sc-snjeg)"></circle>
    <circle cx="0" cy="-88" r="27" fill="url(#sc-snjeg)"></circle>
    <circle cx="0" cy="-128" r="19" fill="url(#sc-snjeg)"></circle>
    <g fill="#1a1a1a">
      <circle cx="0" cy="-96" r="2.6"></circle>
      <circle cx="0" cy="-82" r="2.6"></circle>
      <circle cx="0" cy="-50" r="2.8"></circle>
      <circle cx="-7" cy="-133" r="2.2"></circle>
      <circle cx="7" cy="-133" r="2.2"></circle>
      <circle cx="-8" cy="-121" r="1.2"></circle>
      <circle cx="-4" cy="-118.5" r="1.2"></circle>
      <circle cx="0" cy="-117.5" r="1.2"></circle>
      <circle cx="4" cy="-118.5" r="1.2"></circle>
      <circle cx="8" cy="-121" r="1.2"></circle>
    </g>
    <path d="M0 -129 L20 -125 L0 -123 Z" fill="#e0782b"></path>
    <path d="M-19 -116 Q0 -104 19 -116 L18 -107 Q0 -96 -18 -107 Z" fill="#a61c1c"></path>
    <path d="M8 -106 L20 -108 L24 -78 L18 -80 L15 -76 L11 -80 Z" fill="#8b0000"></path>
    <path d="M-19 -116 Q0 -104 19 -116" stroke="#d4af37" stroke-width="1.5" fill="none"></path>
    <rect x="-22" y="-146" width="44" height="5" rx="2" fill="#0f2a1f"></rect>
    <rect x="-14" y="-172" width="28" height="27" rx="2" fill="#143627"></rect>
    <rect x="-14" y="-153" width="28" height="6" fill="#a61c1c"></rect>
    <path d="M-14 -172 q14 -6 28 0 v3 q-14 -4 -28 0 Z" fill="#faf6f0"></path>
  </g>

  <!-- saonice s darovima -->
  <g transform="translate(900 470)">
    <ellipse cx="6" cy="2" rx="82" ry="7" fill="#9fb1ad" opacity="0.5"></ellipse>
    <!-- darovi -->
    <path d="M-26 -52 Q-40 -84 -18 -92 Q0 -98 10 -82 Q18 -68 8 -52 Z" fill="#7a5a34"></path>
    <path d="M-20 -88 Q-12 -98 -4 -90" stroke="#d4af37" stroke-width="3" fill="none" stroke-linecap="round"></path>
    <rect x="6" y="-76" width="30" height="28" fill="#1b4332"></rect>
    <rect x="19" y="-76" width="5" height="28" fill="#d4af37"></rect>
    <rect x="6" y="-65" width="30" height="5" fill="#d4af37"></rect>
    <path d="M21 -76 q-10 -12 -12 -3 q0 5 12 3 q12 2 12 -3 q-2 -9 -12 3" fill="#d4af37"></path>
    <rect x="-44" y="-66" width="22" height="18" fill="#faf6f0"></rect>
    <rect x="-35" y="-66" width="4" height="18" fill="#a61c1c"></rect>
    <!-- korito -->
    <path d="M-66 -22 L52 -22 Q74 -22 78 -46 Q80 -62 70 -70 Q60 -76 54 -68 Q62 -66 60 -56 Q58 -48 46 -48 L-34 -48 Q-44 -48 -46 -62 Q-48 -80 -62 -82 Q-76 -82 -76 -68 Q-70 -72 -66 -64 Q-64 -44 -66 -22 Z" fill="url(#sc-saonice)"></path>
    <path d="M-60 -30 L50 -30 Q66 -30 70 -48" stroke="url(#sc-zlato)" stroke-width="2.5" fill="none" stroke-linecap="round"></path>
    <path d="M-70 -70 Q-62 -78 -56 -66 Q-54 -50 -56 -36" stroke="url(#sc-zlato)" stroke-width="2" fill="none" stroke-linecap="round"></path>
    <!-- nosači i salinci -->
    <path d="M-44 -22 V-4 M34 -22 V-4" stroke="url(#sc-zlato)" stroke-width="4"></path>
    <path d="M-82 -4 H60 Q88 -4 90 -28 Q90 -40 80 -40 Q74 -40 74 -34" stroke="url(#sc-zlato)" stroke-width="5" fill="none" stroke-linecap="round"></path>
    <!-- snijeg na rubu -->
    <path d="M-76 -70 Q-70 -86 -60 -82 Q-52 -78 -50 -70 Q-58 -76 -64 -74 Q-70 -76 -76 -70 Z" fill="#faf6f0"></path>
  </g>

  <!-- nanosi u prvom planu -->
  <path d="M0 500 Q240 470 520 492 T1000 488 T1440 478 V520 H0 Z" fill="#faf6f0"></path>
</svg>
