---
// Čestitka koju primatelj vidi kad se kuverta otvori. Cijela čestitka je jedna slika nacrtana na canvas
// (scripts/cestitka.ts): ista se slika prikazuje na kartici u kuverti (Envelope.astro), ovdje i u galeriji
// nakon "Spremi kao sliku". Tekst je zato i u atributu alt, za čitače zaslona.
import { tema as temaInfo } from '../lib/teme';
import type { Podaci } from '../scripts/cestitka';

interface Props {
  tema: string;
  naslov: string;
  poruka: string;
  od: string;
  slika: string | null; // javni URL slike ili null
  gumbi?: boolean; // Spremi kao sliku / Otvori ponovno
}
const { tema, naslov, poruka, od, slika, gumbi = true } = Astro.props;
const info = temaInfo(tema);
const podaci: Podaci = { tema: info.key, karta: info.karta, naslov, poruka, od, slika };
const alt = [naslov, poruka, od].filter(Boolean).join('. ');
---

<main class="cest">
  <div class="karta" id="karta">
    <img id="karta-slika" alt={alt} width="1080" height="1350" />
  </div>
  {
    gumbi && (
      <>
        <div class="gumbi">
          <button type="button" class="gumb" id="spremi" disabled>
            Spremi kao sliku
          </button>
          <button type="button" class="gumb gumb--sporedni" id="ponovi">
            Otvori ponovno
          </button>
        </div>
        <p class="napomena" id="napomena">
          Na mobitelu se otvara izbornik za dijeljenje: odaberite „Spremi sliku”.
        </p>
      </>
    )
  }
</main>
<script type="application/json" id="cestitka-podaci" set:html={JSON.stringify(podaci).replace(/</g, '\\u003c')} />

<script>
  import { nacrtaj, spremi, uBlob, type Podaci } from '../scripts/cestitka';

  const podaci = JSON.parse(document.getElementById('cestitka-podaci')?.textContent ?? 'null') as Podaci | null;
  const slika = document.getElementById('karta-slika') as HTMLImageElement | null;
  const gumb = document.getElementById('spremi') as HTMLButtonElement | null;
  const napomena = document.getElementById('napomena');
  let blob: Blob | null = null;

  // Slika se pripremi odmah (dok je kuverta još zatvorena) i postavi i na karticu u kuverti.
  (async () => {
    if (!podaci || !slika) return;
    try {
      blob = await uBlob(await nacrtaj(podaci));
      if (!blob) throw new Error('canvas');
      const url = URL.createObjectURL(blob);
      slika.src = url;
      const mala = document.querySelector<HTMLImageElement>('.inv-env__card-slika');
      if (mala) mala.src = url;
      if (gumb) gumb.disabled = false;
    } catch (e) {
      console.error('cestitka', e);
      if (napomena) napomena.textContent = 'Čestitka se nije uspjela prikazati. Osvježite stranicu.';
    }
  })();

  document.getElementById('ponovi')?.addEventListener('click', () => {
    // Pokaži kuvertu ponovno: zaboravi da je otvorena na ovom uređaju.
    try {
      for (const k of Object.keys(localStorage)) if (k.startsWith('cestitka-kuverta:')) localStorage.removeItem(k);
    } catch {}
    location.reload();
  });

  gumb?.addEventListener('click', async () => {
    if (!blob) return;
    gumb.disabled = true;
    try {
      await spremi(blob);
    } catch (e) {
      console.error('spremi', e);
      if (napomena) napomena.textContent = 'Slika se nije spremila. Pokušajte ponovno ili napravite snimku zaslona.';
    } finally {
      gumb.disabled = false;
    }
  });
</script>
