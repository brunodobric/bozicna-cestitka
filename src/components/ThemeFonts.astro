---
// Vlastito posluživanje fontova (bez Google Fonts CDN-a): datoteke dolaze iz npm paketa @fontsource
// i Vite ih objavljuje pod /_astro/. Uključujemo samo podskupove latin i latin-ext (č ć đ š ž).
// Preglednik preuzima font tek kad ga neki tekst stvarno koristi, a ovdje deklariramo samo
// obitelji koje traži tema (ili platforma), pa primatelj dobiva samo fontove svoje teme.
// Preuzeto iz Kuverte; ostavljene su samo obitelji koje čestitke koriste.
import type { FontFamily } from '../lib/fontovi';

import garamondLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import garamondExt from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-ext-wght-normal.woff2?url';
import garamondItLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-italic.woff2?url';
import garamondItExt from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-ext-wght-italic.woff2?url';
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import jakartaExt from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-ext-wght-normal.woff2?url';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import montserratExt from '@fontsource-variable/montserrat/files/montserrat-latin-ext-wght-normal.woff2?url';

import gvLatin from '@fontsource/great-vibes/files/great-vibes-latin-400-normal.woff2?url';
import gvExt from '@fontsource/great-vibes/files/great-vibes-latin-ext-400-normal.woff2?url';
import pinLatin from '@fontsource/pinyon-script/files/pinyon-script-latin-400-normal.woff2?url';
import pinExt from '@fontsource/pinyon-script/files/pinyon-script-latin-ext-400-normal.woff2?url';
import parLatin from '@fontsource/parisienne/files/parisienne-latin-400-normal.woff2?url';
import parExt from '@fontsource/parisienne/files/parisienne-latin-ext-400-normal.woff2?url';
import berLatin from '@fontsource/berkshire-swash/files/berkshire-swash-latin-400-normal.woff2?url';
import berExt from '@fontsource/berkshire-swash/files/berkshire-swash-latin-ext-400-normal.woff2?url';
import pfLatin from '@fontsource/playfair-display/files/playfair-display-latin-400-italic.woff2?url';
import pfExt from '@fontsource/playfair-display/files/playfair-display-latin-ext-400-italic.woff2?url';

interface Props {
  families: FontFamily[];
  preload?: FontFamily;
}
const { families, preload } = Astro.props;

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

type Face = { family: string; style: string; weight: string; latin: string; ext: string };
const FACES: Record<FontFamily, Face> = {
  garamond: { family: 'EB Garamond', style: 'normal', weight: '400 800', latin: garamondLatin, ext: garamondExt },
  'garamond-italic': { family: 'EB Garamond', style: 'italic', weight: '400 800', latin: garamondItLatin, ext: garamondItExt },
  jakarta: { family: 'Plus Jakarta Sans', style: 'normal', weight: '200 800', latin: jakartaLatin, ext: jakartaExt },
  montserrat: { family: 'Montserrat', style: 'normal', weight: '100 900', latin: montserratLatin, ext: montserratExt },
  // ukrasna pisma za naslov i potpis čestitke
  'great-vibes': { family: 'Great Vibes', style: 'normal', weight: '400', latin: gvLatin, ext: gvExt },
  pinyon: { family: 'Pinyon Script', style: 'normal', weight: '400', latin: pinLatin, ext: pinExt },
  parisienne: { family: 'Parisienne', style: 'normal', weight: '400', latin: parLatin, ext: parExt },
  berkshire: { family: 'Berkshire Swash', style: 'normal', weight: '400', latin: berLatin, ext: berExt },
  'playfair-italic': { family: 'Playfair Display', style: 'italic', weight: '400', latin: pfLatin, ext: pfExt },
};

const unique = [...new Set(families)];
const css = unique
  .flatMap((key) => {
    const f = FACES[key];
    return [
      [f.latin, LATIN],
      [f.ext, LATIN_EXT],
    ].map(
      ([src, range]) =>
        `@font-face{font-family:'${f.family}';font-style:${f.style};font-weight:${f.weight};font-display:swap;src:url(${src}) format('woff2');unicode-range:${range}}`,
    );
  })
  .join('\n');
const preloadHref = preload ? FACES[preload].latin : null;
---

{preloadHref && <link rel="preload" href={preloadHref} as="font" type="font/woff2" crossorigin />}
<style is:inline set:html={css}></style>
