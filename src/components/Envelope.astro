---
// Kuverta iz Kuverte (src/components/Envelope.astro): primatelj je dodirne, pečat pukne, zaklopac se otvori
// (vidi se podstava), čestitka izađe iz kuverte, kuverta nestane, a čestitka dođe na svoje mjesto na ekranu.
// Kartica u kuverti je ista slika kao gotova čestitka (postavlja je skripta u Karta.astro).
// Izgled prati dizajn (CSS varijable iz lib/teme.ts). Prikazuje se samo kad skripta u <head> (EnvelopeHead)
// doda <html class="env">; bez JS-a je skrivena.
import { grancica } from '../lib/ilustracije';

interface Props {
  storageKey: string; // '' = prikaži svaki put (primjeri, pregled); inače pamtimo da je primatelj već otvorio
  za: string; // "Za Anu", stoji iznad upute
  pecat: string; // znak na pečatu
  deco: 'bozikovina' | 'imela' | 'bor'; // grančica ispod pečata
}
const { storageKey, za, pecat, deco } = Astro.props;
const LIST = {
  bozikovina: 'M0 0 Q8 -15 18 -8 Q23 -19 32 -10 Q39 -19 46 -8 Q55 -10 64 0 Q55 10 46 8 Q39 19 32 10 Q23 19 18 8 Q8 15 0 0 Z',
  imela: 'M0 0 C10 -13 44 -16 62 -5 C67 -2 67 3 62 6 C44 15 10 11 0 0 Z',
};
---

<div class="inv-env" id="kuverta" data-key={storageKey} role="dialog" aria-modal="true" aria-label="Čestitka u kuverti">
  <button type="button" class="inv-env__open" aria-label="Otvori čestitku">
    <span class="inv-env__stage" aria-hidden="true">
      <span class="inv-env__envelope">
        <span class="inv-env__back"></span>
        <span class="inv-env__dzep">
          <span class="inv-env__card"><img class="inv-env__card-slika" alt="" width="1080" height="1350" /></span>
        </span>
        <svg class="inv-env__front" viewBox="0 0 300 200" preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="env-sj-l" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity="0.1"></stop>
              <stop offset="1" stop-color="#000" stop-opacity="0.16"></stop>
            </linearGradient>
            <linearGradient id="env-sj-d" x1="1" y1="0" x2="0" y2="0">
              <stop offset="0" stop-color="#000" stop-opacity="0.06"></stop>
              <stop offset="1" stop-color="#000" stop-opacity="0.2"></stop>
            </linearGradient>
            <linearGradient id="env-sj-dno" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity="0.2"></stop>
              <stop offset="0.5" stop-color="#fff" stop-opacity="0.04"></stop>
              <stop offset="1" stop-color="#000" stop-opacity="0.14"></stop>
            </linearGradient>
            <filter id="env-mek" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="3.5"></feGaussianBlur>
            </filter>
            <clipPath id="env-okvir"><rect width="300" height="200" rx="3"></rect></clipPath>
          </defs>
          <path class="inv-env__side" d="M0 0 L150 112 L0 200 Z"></path>
          <path d="M0 0 L150 112 L0 200 Z" fill="url(#env-sj-l)"></path>
          <path class="inv-env__side" d="M300 0 L150 112 L300 200 Z"></path>
          <path d="M300 0 L150 112 L300 200 Z" fill="url(#env-sj-d)"></path>
          <!-- sjena donjeg preklopa na bočnima: papir je debeo -->
          <g clip-path="url(#env-okvir)">
            <path d="M0 196 L150 91 L300 196 Z" fill="#000" opacity="0.28" filter="url(#env-mek)"></path>
          </g>
          <path class="inv-env__bottom" d="M0 200 L150 96 L300 200 Z"></path>
          <path d="M0 200 L150 96 L300 200 Z" fill="url(#env-sj-dno)"></path>
          <path class="inv-env__fold" d="M0 0 L150 112 L300 0 M0 200 L150 96 L300 200"></path>
          <path class="inv-env__sjaj" d="M2 200 L150 97.5 L298 200"></path>
        </svg>
        <span class="inv-env__tekstura"></span>
        <span class="inv-env__deco">
          <!-- grančica ispod pečata: božikovina, imela ili bor -->
          <svg viewBox="0 0 200 120" focusable="false">
            <defs>
              <radialGradient id="env-bobica" cx="0.35" cy="0.3" r="0.8">
                <stop offset="0" stop-color="#fff" stop-opacity="0.75"></stop>
                <stop offset="0.3" stop-color="#fff" stop-opacity="0"></stop>
                <stop offset="1" stop-color="#000" stop-opacity="0.35"></stop>
              </radialGradient>
            </defs>
            <g transform="translate(100 60)">
              {
                deco === 'bor' ? (
                  <g set:html={grancica()} />
                ) : (
                  [
                    [198, 2],
                    [158, 1],
                    [-18, 1],
                    [22, 2],
                    [90, 2],
                  ].map(([kut, ton]) => (
                    <g transform={`rotate(${kut}) translate(16 0)`}>
                      <path d={LIST[deco]} class={`inv-env__list inv-env__list--${ton}`} />
                      <path d="M3 0 H56" class="inv-env__zila" />
                    </g>
                  ))
                )
              }
              {
                [
                  [-46, 14],
                  [44, -22],
                  [38, 30],
                ].map(([x, y]) => (
                  <>
                    <circle cx={x} cy={y} r="6.5" class="inv-env__bobica" />
                    <circle cx={x} cy={y} r="6.5" fill="url(#env-bobica)" />
                  </>
                ))
              }
            </g>
          </svg>
        </span>
        <span class="inv-env__flap-shadow"><span></span></span>
        <span class="inv-env__flap">
          <span class="inv-env__flap-face inv-env__flap-face--out"></span>
          <span class="inv-env__flap-face inv-env__flap-face--in"></span>
          <svg viewBox="0 0 300 120" preserveAspectRatio="none" focusable="false">
            <path class="inv-env__flap-edge" d="M0 0 L150 118 L300 0"></path>
          </svg>
        </span>
        <span class="inv-env__seal">
          <span class="inv-env__seal-text">{pecat}</span>
        </span>
      </span>
      <span class="inv-env__ground"></span>
    </span>
  </button>
  <p class="inv-env__hint" aria-live="polite">
    {za && <span class="inv-env__za">{za}</span>}
    Dodirnite za otvaranje
  </p>
  <button type="button" class="inv-env__skip">Preskoči</button>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('kuverta');
    if (!el) return;
    window.__envReady = true;
    if (!root.classList.contains('env')) {
      el.remove();
      return;
    }
    var key = el.getAttribute('data-key');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var done = false;
    // Uputa se pojavi brzo nakon što kuverta sjedne na mjesto.
    var hint = setTimeout(function () {
      el.classList.add('is-hinting');
    }, 1800);

    function remember() {
      if (!key) return;
      try {
        localStorage.setItem('cestitka-kuverta:' + key, '1');
      } catch (e) {}
    }
    function finish() {
      el.classList.add('is-gone');
      root.classList.remove('env');
      document.dispatchEvent(new Event('mwi:env-open'));
      setTimeout(function () {
        el.remove();
      }, reduced ? 200 : 450);
    }
    function open(animate) {
      if (done) return;
      done = true;
      clearTimeout(hint);
      remember();
      if (animate && !reduced) {
        el.classList.add('is-open');
        // Čestitka je izašla: kuverta nestaje, a kartica se pomakne i naraste točno na mjesto gotove čestitke.
        setTimeout(function () {
          var card = el.querySelector('.inv-env__card');
          var cilj = document.getElementById('karta');
          if (card && cilj) {
            var c = card.getBoundingClientRect();
            var t = cilj.getBoundingClientRect();
            var m = new DOMMatrix(getComputedStyle(card).transform);
            var dx = t.left + t.width / 2 - (c.left + c.width / 2) + m.m41;
            var dy = t.top + t.height / 2 - (c.top + c.height / 2) + m.m42;
            card.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(' + t.width / c.width + ')';
          }
          el.classList.add('is-zoom');
        }, 1900);
        setTimeout(finish, 2750);
      } else {
        finish();
      }
    }
    el.addEventListener('click', function (e) {
      open(!e.target.closest('.inv-env__skip'));
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') open(false);
    });
  })();
</script>
