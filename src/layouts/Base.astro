---
// Kostur stranica platforme (početna, uređivač, pravne stranice). Čestitke za primatelja
// koriste CestitkaLayout.astro i ne učitavaju ovaj CSS.
import '../styles/platform.css';
import ThemeFonts from '../components/ThemeFonts.astro';
import { SITE_NAME, siteOrigin } from '../lib/seo';
import Rubovi from '../components/Rubovi.astro';
import Kolacici from '../components/Kolacici.astro';
import { metaPiksel, type PikselDogadaj } from '../lib/piksel';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  klasa?: string; // dodatna klasa na <body> (početna: noćna scena)
  themeColor?: string;
  // boja ispod stranice (html): iPhone je pokazuje iznad i ispod stranice i kod povlačenja preko ruba
  pozadina?: string;
  // Meta piksel: događaj ove stranice (plaćanje, kupnja); šalje se samo uz pristanak na kolačiće
  piksel?: PikselDogadaj | null;
}
const { title, description, noindex = false, klasa = '', pozadina = '#faf6f0', piksel = null } = Astro.props;
const imaPiksel = metaPiksel() !== '';
const themeColor = Astro.props.themeColor ?? pozadina;
const origin = siteOrigin(Astro.url);
const path = Astro.url.pathname;
const canonical = origin + (path === '/' ? '/' : path.replace(/\/$/, ''));
---

<!doctype html>
<html lang="hr" style={`background-color:${pozadina}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${origin}/og-cestitka.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <ThemeFonts families={['garamond', 'garamond-italic', 'jakarta']} preload="garamond" />
  </head>
  <body class:list={['platform', klasa]}>
    <Rubovi boja={pozadina} />
    <header class="p-header">
      <a class="p-logo" href="/">{SITE_NAME}</a>
    </header>
    <main class="p-main">
      <slot />
    </main>
    <footer class="p-footer">
      <span>{SITE_NAME}</span>
      <nav aria-label="Pravne informacije">
        <a href="/privatnost">Privatnost</a>
        <a href="/uvjeti">Uvjeti korištenja</a>
        {imaPiksel && (
          <button type="button" class="p-footer__kolacici" data-kolacici-postavke hidden>
            Kolačići
          </button>
        )}
      </nav>
    </footer>
    <Kolacici dogadaj={piksel} />
  </body>
</html>
