---
// Početna stranica: noćna božićna scena (lampice, mjesec, snijeg, drvca, svjetiljke, snjegović, saonice).
// Cijena je ispod gumba u uvodu i uz donji gumb (lib/cijena.ts). SEO tekst i česta pitanja dolaze u koraku 12.
import '@fontsource/great-vibes/latin-400.css';
import '@fontsource/great-vibes/latin-ext-400.css';
import '../styles/pocetna.css';
import Base from '../layouts/Base.astro';
import NocnaScena from '../components/NocnaScena.astro';
import Snijeg from '../components/Snijeg.astro';
import { TEME } from '../lib/teme';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/seo';
import { CIJENA_JEDNE, CIJENA_KRATKO } from '../lib/cijena';

// Lampice na žici: lukovi široki 120, po tri žaruljice na svakom.
const BOJE = ['#f5cf58', '#e0483f', '#faf6f0', '#3fa66e'];
const lampice: { x: number; y: number; boja: string; d: string }[] = [];
for (let luk = 0; luk < 12; luk++) {
  [
    [24, 21],
    [60, 27],
    [96, 21],
  ].forEach(([dx, y], i) => {
    const n = luk * 3 + i;
    lampice.push({ x: luk * 120 + dx, y, boja: BOJE[n % BOJE.length], d: ((n * 0.43) % 2.6).toFixed(2) });
  });
}
const zica = 'M0 6 ' + Array.from({ length: 12 }, (_, i) => `Q${i * 120 + 60} 46 ${i * 120 + 120} 6`).join(' ');

// Zvijezde: uvijek isti raspored (bez Math.random, da se stranica ne razlikuje između poslužitelja i preglednika).
let sjeme = 7;
const rnd = () => ((sjeme = (sjeme * 16807) % 2147483647) - 1) / 2147483646;
const zvijezde = Array.from({ length: 46 }, () => ({
  l: (rnd() * 100).toFixed(1),
  t: (rnd() * 62).toFixed(1),
  v: (1 + rnd() * 1.6).toFixed(1),
  d: (rnd() * 4).toFixed(1),
}));
---

<Base title={`Digitalna božićna čestitka u kuverti · ${SITE_NAME}`} description={SITE_DESCRIPTION} klasa="pocetna" pozadina="#060f0c" themeColor="#060f0c">
  <Snijeg />
  <section class="n-hero">
    <div class="n-zvijezde" aria-hidden="true">
      {zvijezde.map((z) => <i style={`left:${z.l}%;top:${z.t}%;width:${z.v}px;height:${z.v}px;animation-delay:${z.d}s`} />)}
    </div>
    <span class="n-mjesec" aria-hidden="true"></span>
    <svg class="n-lampice" viewBox="0 0 1440 60" preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false">
      <path d={zica} fill="none" stroke="#35574a" stroke-width="1.5"></path>
      {
        lampice.map((l) => (
          <g transform={`translate(${l.x} ${l.y})`}>
            <rect x="-2.5" y="-3" width="5" height="5" rx="1" fill="#04100b" />
            <g class="n-lampice__zarulja" style={`animation-delay:${l.d}s`}>
              <circle cy="8" r="13" fill={l.boja} opacity="0.2" />
              <ellipse cy="8" rx="5" ry="7" fill={l.boja} />
              <ellipse cx="-1.6" cy="5.5" rx="1.4" ry="2.4" fill="#fff" opacity="0.6" />
            </g>
          </g>
        ))
      }
    </svg>

    <div class="n-hero__tekst">
      <h1>
        <span class="n-hero__pismo">Božićna čestitka</span>
        <span class="n-hero__red">koja stigne u kuverti</span>
      </h1>
      <p class="n-hero__lead">
        Napišete poruku, po želji dodate fotografiju i pošaljete link u poruci. Primatelj dodirne pečat, kuverta se otvori, a
        čestitku može spremiti kao sliku u galeriju.
      </p>
      <div class="n-hero__cta">
        <a class="p-btn" href="/napravi">Napravi čestitku</a>
        <a class="p-btn p-btn--ghost" href="/primjer/klasicna">Pogledaj primjer</a>
      </div>
      <p class="n-hero__cijena">{CIJENA_KRATKO}</p>
      <p class="n-hero__napomena">Plaćate tek kad čestitku vidite u kuverti. Bez registracije i bez aplikacije.</p>
    </div>
    <NocnaScena />
  </section>

  <section class="n-snijeg">
    <div class="n-wrap">
      <h2 class="n-naslov">Kako ide</h2>
      <ol class="n-koraci">
        <li>
          <h3>Napišete čestitku</h3>
          <p>Odaberete čestitku, upišete za koga je, poruku i potpis. Fotografija je neobavezna.</p>
        </li>
        <li>
          <h3>Pošaljete link</h3>
          <p>Nakon plaćanja ({CIJENA_JEDNE}) dobijete link i gumb za slanje u WhatsApp, Viber ili Messenger.</p>
        </li>
        <li>
          <h3>Primatelj otvori kuvertu</h3>
          <p>Pečat pukne, kartica izađe i pretvori se u čestitku koju može spremiti kao sliku.</p>
        </li>
      </ol>
    </div>
    <svg class="n-snijeg__rub" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M0 0 H1440 V22 Q1320 58 1180 30 T900 34 T620 26 T330 38 T0 20 Z" fill="#faf6f0"></path>
    </svg>
  </section>

  <section class="n-kuverte">
    <div class="n-wrap">
      <h2 class="n-naslov n-naslov--svijetli">Devet čestitki</h2>
      <p class="n-kuverte__uvod">Svaka dolazi u svojoj kuverti. Dodirnite čestitku i otvorite primjer.</p>
      <div class="n-teme">
        {
          TEME.map((t) => (
            <a class="n-tema" href={`/primjer/${t.key}`}>
              <img src={`/primjeri/${t.key}.jpg`} alt={`Primjer čestitke: ${t.naziv}`} width="540" height="675" loading="lazy" decoding="async" />
              <span class="n-tema__tekst">
                <strong>{t.naziv}</strong>
                <span>{t.opis}</span>
              </span>
            </a>
          ))
        }
      </div>
      <p class="n-kuverte__cta"><a class="p-btn" href="/napravi">Napravi čestitku</a></p>
      <p class="n-kuverte__cijena">{CIJENA_KRATKO}</p>
    </div>
  </section>
</Base>
