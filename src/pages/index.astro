---
// Početna stranica (korak 3 plana: jedan gumb). SEO tekst, cijena i česta pitanja dolaze u koraku 12,
// kad budu odlučeni ime, domena i cijena.
import Base from '../layouts/Base.astro';
import { TEME } from '../lib/teme';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/seo';

const UZORCI: Record<string, { bg: string; front: string; flap: string; seal: string }> = {
  klasicna: { bg: '#143627', front: '#a61c1c', flap: '#b42424', seal: '#d4af37' },
  zimska: { bg: '#14213d', front: '#f3f6fa', flap: '#fbfcfe', seal: '#a9b8cc' },
  moderna: { bg: '#f6f3ee', front: '#ffffff', flap: '#ffffff', seal: '#b3262e' },
};
---

<Base title={`Digitalna božićna čestitka u kuverti · ${SITE_NAME}`} description={SITE_DESCRIPTION}>
  <section class="h-hero">
    <div>
      <h1>Božićna čestitka koja stigne u kuverti</h1>
      <p class="h-hero__lead">
        Napišete poruku, po želji dodate fotografiju i pošaljete link na WhatsApp ili Viber. Primatelj dodirne pečat, kuverta se
        otvori, a čestitku može spremiti kao sliku u galeriju.
      </p>
      <div class="h-hero__cta">
        <a class="p-btn" href="/napravi">Napravi čestitku</a>
        <a class="p-btn p-btn--ghost" href="/primjer/klasicna">Pogledaj primjer</a>
      </div>
      <p class="p-small p-muted" style="margin-top:1rem">Bez registracije i bez aplikacije, ni za vas ni za primatelja.</p>
    </div>
    <a class="h-hero__slika" href="/primjer/klasicna" aria-label="Otvori primjer čestitke">
      <span class="h-tema__kuverta" style="--flap:#b42424;--seal:#d4af37;background:#a61c1c;width:min(60%,280px);height:auto;aspect-ratio:3/2"></span>
    </a>
  </section>

  <h2>Kako ide</h2>
  <ol class="h-koraci">
    <li>
      <h3>Napišete čestitku</h3>
      <p>Odaberete kuvertu, upišete kome je, poruku i potpis. Fotografija je neobavezna.</p>
    </li>
    <li>
      <h3>Pošaljete link</h3>
      <p>Nakon plaćanja dobijete link i gumb za slanje u WhatsApp, Viber ili Messenger.</p>
    </li>
    <li>
      <h3>Primatelj otvori kuvertu</h3>
      <p>Pečat pukne, kartica izađe i pretvori se u čestitku koju može spremiti kao sliku.</p>
    </li>
  </ol>

  <h2>Kuverte</h2>
  <div class="h-teme">
    {
      TEME.map((t) => {
        const u = UZORCI[t.key];
        return (
          <a class="h-tema" href={`/primjer/${t.key}`}>
            <span class="h-tema__uzorak" style={`background:${u.bg}`}>
              <span class="h-tema__kuverta" style={`background:${u.front};--flap:${u.flap};--seal:${u.seal}`} />
            </span>
            <span class="h-tema__tekst">
              <strong>{t.naziv}</strong>
              <span>{t.opis}</span>
            </span>
          </a>
        );
      })
    }
  </div>
</Base>
